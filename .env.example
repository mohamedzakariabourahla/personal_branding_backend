# Core services
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/personal-branding-saas
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
REDIS_HOST=localhost
REDIS_PORT=6379

# Security
SECURITY_JWT_SECRET=change-me
SECURITY_JWT_ISSUER=personal-branding-saas-local
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
APP_ENCRYPTION_KEY_ID=local-dev
APP_CORS_ALLOWED_ORIGINS=https://pb.local,http://localhost:3000

# Mail
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@local.test
APP_MAIL_RESET_BASE_URL=https://pb.local/reset-password?token=
APP_MAIL_VERIFY_BASE_URL=https://pb.local/verify-email?token=

# Meta / Instagram
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=https://pb.local/meta/callback
META_SCOPES=pages_show_list,instagram_basic,instagram_content_publish,pages_manage_posts,pages_read_engagement

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://pb.local/tiktok/callback
TIKTOK_SCOPES=user.info.basic,video.publish

# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://pb.local/youtube/callback
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.readonly

# Optional overrides
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
